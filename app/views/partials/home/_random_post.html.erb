<!--
  Home module — random post. Static sites can't roll randomness at
  request time, so this partial renders a small pool of candidate
  posts (up to `pool_cap` newest) and ships a tiny script that picks
  one to show on each page load. The first card is the no-JS
  fallback; the rest are server-rendered with `hidden` and unhidden
  by `random-pool.js` after the page loads (and again on every back/
  forward cache restore, so the user doesn't see the same card on
  navigation).

  Toggled by `home.random_post: true` in config/site.yml.
  Style via `.home-module*` class hooks in your theme.
-->
<%
  pool_cap = 12        # cap the pool size for page-weight predictability
  candidates = site.collection('posts').first(pool_cap)
  # Only the first card is initially visible (the no-JS fallback);
  # the rest are `hidden` and only swapped in by random-pool.js
  # post-load. So even when this module is priority, only the i=0
  # image gets the eager hint — pre-eagerly fetching all 12 would
  # waste bandwidth on cards the user never sees.
  _priority = defined?(priority_image) && priority_image
%>
<% if candidates.any? %>
<section class="home-module home-module--random-post" aria-label="From the archive">
  <header class="home-module__header">
    <h2 class="home-module__heading">From the archive</h2>
    <a class="home-module__see-all" href="<%= sanitized_url(collection_index_url('posts')) %>">All <%= collection_index_label('posts') %> &rarr;</a>
  </header>
  <div class="home-module__pool" data-random-pool>
    <% candidates.each_with_index do |post, i| %>
      <% _eager = _priority && i.zero? %>
      <article class="home-module__item"<%= ' hidden' if i.positive? %>>
        <% if (img = post.frontmatter['image']) %>
          <a class="home-module__cover" href="<%= sanitized_url(post.url) %>">
            <img src="<%= sanitized_url(bundle_asset_url_for(post, img)) %>"
                 alt="<%= post.title %>"
                 loading="<%= _eager ? 'eager' : 'lazy' %>"
                 <% if _eager %>fetchpriority="high"<% end %>
                 decoding="async">
          </a>
        <% end %>
        <div class="home-module__body">
          <h3 class="home-module__title">
            <a href="<%= sanitized_url(post.url) %>"><%= post.title %></a>
          </h3>
          <% if post.date %>
            <p class="home-module__meta">
              <time datetime="<%= post.date.iso8601 %>"><%= local_time(post.date) %></time>
              <% if post.respond_to?(:content) && post.content.to_s.length.positive? %>
                · <%= reading_time(post.content) %>
              <% end %>
            </p>
          <% end %>
          <% if (desc = post.frontmatter['description'].to_s) && !desc.empty? %>
            <p class="home-module__description"><%= truncate(desc, length: 160) %></p>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>
  <script src="<%= asset_path('js/random-pool.js') %>" defer></script>
</section>
<% end %>
