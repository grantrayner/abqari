<%#
  Publication detail header — cover image (left) + title/metadata
  /buy buttons (right), on a single 2-column grid on tablet and up.
  Extracted from publication.html.erb so the layout can read as a
  high-level sequence (banners → header → description → body →
  sections) rather than ~50 lines of header plumbing.

  Required local: `folio` (Hash — Folio payload or {}).
  Reads `show.*` from collection_config('publications')['show'].

  Field resolution: frontmatter wins per-field over Folio (so a manual
  override page can patch any single field without re-stating the rest).
%>
<%
  fm   = page.frontmatter
  show = (site.collection_config('publications')['show'] || {})
%>
<header class="publication__header">
  <% cover = folio['cover_url'] || fm['cover'] || fm['cover_image'] %>
  <% if cover %>
    <img class="publication__cover" src="<%= sanitized_url(cover) %>" alt="<%= folio['title'] || fm['title'] || page.title %> cover">
  <% end %>

  <div class="publication__intro">
    <h1><%= folio['title'] || fm['title'] || page.title %></h1>

    <% if show.fetch('show_tagline', true) && (tagline = folio['tagline'] || fm['tagline']) %>
      <p class="publication__tagline"><%= tagline %></p>
    <% end %>

    <%# Optional metadata fields — ISBN, pages, published date —
        rendered as a small muted block of detail lines. %>
    <% if show.fetch('show_isbn', true) && (isbn = folio['isbn'] || fm['isbn']) %>
      <p class="publication__isbn">ISBN <%= isbn %></p>
    <% end %>

    <% if show.fetch('show_pages', true) && (pages = folio['pages'] || fm['pages']) %>
      <p class="publication__pages"><%= pluralize(pages, 'page') %></p>
    <% end %>

    <% if show.fetch('show_published', true) && (published = folio['published_at'] || fm['published_at'] || fm['publish_date']) %>
      <p class="publication__published">First published <time datetime="<%= published %>"><%= local_time(published) %></time></p>
    <% end %>

    <%# Purchase area — price sits adjacent to the buy buttons so
        they read as a single unit (e-commerce convention). %>
    <% if show.fetch('show_price', true) && (price = folio.dig('price', 'formatted') || fm['price']) %>
      <p class="publication__price"><%= price %></p>
    <% end %>

    <%# Folio-driven buy / cart buttons (when Folio data is present
        for this slug). Helpers return '' when no URL is loaded. %>
    <p class="publication__buttons">
      <%== folio_buy_button(page.respond_to?(:slug) ? page.slug : nil, kind: :book) %>
      <%== folio_cart_button(page.respond_to?(:slug) ? page.slug : nil, kind: :book) %>
      <%# Legacy frontmatter buy button — for manual publications without
          Folio. Renders only when neither Folio button covers it AND a
          buy_url is set in frontmatter. %>
      <% if folio['buy_now_url'].nil? && folio['add_to_cart_url'].nil? &&
           fm['buy_url'] && (safe_buy_url = sanitized_url(fm['buy_url'])) %>
        <a class="folio-button folio-button--buy" href="<%= safe_buy_url %>" rel="noopener noreferrer">
          <%= fm['buy_label'] || 'Buy now' %>
        </a>
      <% end %>
    </p>
  </div>
</header>
