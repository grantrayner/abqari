<!--
  Related items — renders below a show view (post, photo, publication)
  with up to N pages from the same collection that share tags / series
  / countries / etc. with the current page.

  Usage from any layout:

      <%%= render 'partials/related_items' %>

  Optional locals:
      <%%= render 'partials/related_items', limit: 6, match_by: %w[tags] %>

  Wired into post.html.erb, photo.html.erb, publication.html.erb by
  default. Renders nothing when there are no related items — never
  pads with unrelated content.

  Config (per collection in config/site.yml):

      collections:
        posts:
          related:
            enabled: true       # set false to disable for this collection
            limit: 3            # max items to show
            match_by: tags      # field name or list of names
            show_image: true    # when true, always render a cover box —
                                #   a placeholder tile (no <img>) for items
                                #   that don't have `image:` / `cover:` in
                                #   frontmatter. Keeps the grid visually
                                #   consistent when some items have heroes
                                #   and others don't. Set false to render
                                #   text-only cards regardless.

  Workshops-specific extras — workshops carry richer meta than the
  generic `date:` field, so the related card below the title can
  show dates and/or location. Both default true; flip false to hide:

      collections:
        workshops:
          related:
            show_dates: true     # date_from – date_to (or duration fallback)
            show_location: true  # city / country / "Remote"
-->
<%
  # Resolve effective limit/match_by — explicit local override > collection
  # config default. Always fetch the full ranked list, then slice for the
  # visible block. Total count drives the "Show all N" CTA.
  source_collection = page.respond_to?(:collection) ? page.collection : nil
  cfg                = (source_collection ? site.collection_config(source_collection)['related'] : nil) || {}
  override_limit     = defined?(limit)    && limit    ? limit    : nil
  override_match_by  = defined?(match_by) && match_by ? match_by : nil
  effective_limit    = override_limit || cfg.fetch('limit', 3)
  show_image         = cfg.fetch('show_image', true)

  # Workshop-specific meta toggles. For other collections these are
  # ignored (the partial falls back to the simpler `item.date` line).
  is_workshop        = source_collection == 'workshops'
  ws_show_dates      = is_workshop && cfg.fetch('show_dates',    true)
  ws_show_location   = is_workshop && cfg.fetch('show_location', true)

  all_related = site.related(page, match_by: override_match_by)

  # Workshops: hide past entries from the related list — recommending
  # an event that's already happened is noise. A workshop is "past"
  # when its end-date (`date_to` ‖ `date_from`) is strictly before
  # today; dateless evergreen workshops always count as upcoming.
  if is_workshop
    today = Date.today
    all_related = all_related.reject do |item|
      end_date = item.frontmatter['date_to'] || item.frontmatter['date_from']
      end_date && to_time(end_date).to_date < today
    end
  end

  visible = all_related.first(effective_limit)
  total   = all_related.size
%>
<% if visible.any? %>
<%# `related--book` modifier when the source collection is publications,
    so the thumbnail uses a 2:3 book-cover aspect (instead of the
    landscape 4:3 default that crops book covers top/bottom). %>
<section class="related<%= ' related--book' if source_collection == 'publications' %>" aria-labelledby="related-heading">
  <h2 id="related-heading" class="related__heading">Related</h2>
  <ul class="related__list">
    <% visible.each do |item| %>
      <li class="related__item">
        <a href="<%= item.url %>">
          <% if show_image %>
            <% cover = item.frontmatter['image'] || item.frontmatter['cover'] %>
            <div class="related__cover<%= ' related__cover--placeholder' unless cover %>">
              <% if cover %>
                <img src="<%= sanitized_url(bundle_asset_url_for(item, cover)) %>"
                     alt="<%= item.frontmatter['caption'] || item.title %>"
                     loading="lazy"
                     decoding="async">
              <% end %>
            </div>
          <% end %>
          <span class="related__title"><%= item.title %></span>
          <% if is_workshop %>
            <% fm = item.frontmatter %>
            <% if ws_show_dates && (df = fm['date_from']) %>
              <span class="related__date">
                <time datetime="<%= to_time(df).iso8601 %>"><%= local_time(df) %></time>
                <% if (dt = fm['date_to']) && dt != df %>
                  &ndash; <time datetime="<%= to_time(dt).iso8601 %>"><%= local_time(dt) %></time>
                <% end %>
              </span>
            <% elsif ws_show_dates && fm['duration'] %>
              <span class="related__date"><%= fm['duration'] %></span>
            <% end %>
            <% if ws_show_location && fm['location'] %>
              <span class="related__location"><%= fm['location'] %></span>
            <% end %>
          <% elsif item.respond_to?(:date) && item.date %>
            <span class="related__date">
              <time datetime="<%= item.date.iso8601 %>"><%= local_time(item.date) %></time>
            </span>
          <% end %>
        </a>
      </li>
    <% end %>
  </ul>
  <% if total > effective_limit %>
    <p class="related__more">
      <a href="<%= page.url.chomp('/') %>/related/">
        Show all <%= total %> related items
      </a>
    </p>
  <% end %>
</section>
<% end %>
