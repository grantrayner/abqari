---
layout: application
---
<!--
  About page. Extends application.html.erb (the master shell). Reads
  title and the visible lede directly from the page's frontmatter:

      ---
      title: About the Author
      description: A short lede shown under the title…
      ---

  The frontmatter `description:` doubles as the SEO meta description
  AND the visible lede on the page. Omit it to hide the lede; the
  page falls back to the site-wide description for the meta tag.
  The markdown body of `content/about.md` renders below.

  A spam-resistant contact button is appended below the body when
  `contact:` is set in config/site.yml — see partials/_contact_button.
  To remove the button entirely, switch the page's `layout:` to
  `application`, or delete this layout file.
-->
<%
  description = page.frontmatter['description']
%>
<article>
  <header>
    <h1><%= page.title %></h1>
    <% if description && !description.to_s.empty? %>
      <p class="lede"><%= description %></p>
    <% end %>
  </header>
  <%== page.content %>
  <%== render 'partials/contact_button' %>
</article>

<%# Schema.org Person — entity declaration for the site's author,
    used for E-E-A-T. `sameAs` links connect to verified social
    profiles for the entity graph. Optional frontmatter fields
    (`person_name:`, `person_job_title:`, `person_description:`,
    `person_image:`) override site defaults. %>
<%== render 'partials/person_jsonld' %>

