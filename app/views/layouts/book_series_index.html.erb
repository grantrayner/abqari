---
layout: application
---
<%
  description = page.frontmatter['description']

  # URL prefix honours `series.slug:` aliasing.
  cfg = site.collection_config('series')
  prefix = cfg['slug'].to_s.empty? ?
    cfg['permalink'].to_s.sub(':slug/', '').sub(':slug', '') :
    "/#{cfg['slug']}/"
  prefix = '/series/' if prefix.empty?

  # Merged collection — manual content + any externally-sourced
  # entries — minus the index page itself.
  series_list = site.collection('series').reject { |s| s.url == page.url }
%>
<article>
  <header>
    <h1><%= page.title || 'Series' %></h1>
    <% if description && !description.to_s.empty? %>
      <p class="lede"><%= description %></p>
    <% end %>
  </header>

  <% if page.content && !page.content.to_s.strip.empty? %>
    <div class="index-intro"><%== page.content %></div>
  <% end %>

  <ul class="series-index">
    <% series_list.each do |s| %>
      <% fm = s.frontmatter %>
      <li>
        <a href="<%= prefix %><%= s.slug %>/">
          <span class="series-index__name"><%= s.title %></span>
          <% if (count = Array(fm['publications']).size) > 0 %>
            <span class="series-index__count"><%= pluralize(count, 'book') %></span>
          <% end %>
        </a>
      </li>
    <% end %>
  </ul>
</article>
