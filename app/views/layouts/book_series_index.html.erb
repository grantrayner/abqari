---
layout: application
---
<%
  description = page.frontmatter['description']
%>
<article>
  <header>
    <h1><%= page.title || 'Series' %></h1>
    <% if description && !description.to_s.empty? %>
      <p class="lede"><%= description %></p>
    <% end %>
  </header>

  <%== page.content %>

  <ul class="series-index">
    <% Array(site.data['folio_series']).each do |slug, series| %>
      <li>
        <a href="/series/<%= slug %>/">
          <span class="series-index__name"><%= series['name'] %></span>
          <% if (count = Array(series['publications']).size) > 0 %>
            <span class="series-index__count"><%= pluralize(count, 'book') %></span>
          <% end %>
        </a>
      </li>
    <% end %>
  </ul>
</article>
