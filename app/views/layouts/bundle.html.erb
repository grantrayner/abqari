---
layout: application
---
<!--
  Single-bundle detail page. Reads canonical fields from
  `page.frontmatter` (see docs/publications.md). Whether the page is
  a manual `content/bundles/<slug>/index.md` or auto-generated from
  an external publisher with `kind: 'bundle'`, the field names are
  the same.

  Frontmatter shape:

      ---
      layout: bundle
      name: The Light Notebooks Bundle
      tagline: Beginnings and endings.     # optional standfirst
      description: Both volumes packaged together.
      price: $28.00                        # string shorthand or Hash form
      buy_now_url: https://...             # optional
      add_to_cart_url: https://...         # optional
      publications:                        # array of slugs
        - first-light
        - last-light
      ---

  Each slug in `publications:` is resolved against
  `site.collection('publications')`, which includes both manual and
  externally-sourced entries, so the bundle's contents render with
  consistent metadata regardless of where each member book lives.
-->
<article class="bundle">
  <% fm = page.frontmatter %>

  <header>
    <h1><%= page.title %></h1>
    <% if (tagline = fm['tagline']) %>
      <p class="lede bundle__tagline"><%= tagline %></p>
    <% end %>

    <% if (price = fm.dig('price', 'formatted')) %>
      <p class="bundle__price"><%= price %></p>
    <% end %>

    <p class="bundle__buttons">
      <%== buy_button(fm, label: fm['buy_label'] || 'Buy now') %>
      <%== cart_button(fm) %>
    </p>
  </header>

  <%# Description — `description_html` (pre-rendered) when present,
      otherwise the markdown `description` source rendered through
      Commonmarker so inline emphasis, links, and paragraph breaks
      come through. Both fields are canonical-shape per
      docs/publications.md. The selected source is exposed as
      `data-source="…"` for DevTools visibility. %>
  <%
    description_source, description_content =
      if (html = fm['description_html']) && !html.to_s.strip.empty?
        [:description_html, html]
      elsif (text = fm['description']) && !text.to_s.strip.empty?
        [:description, markdown(text)]
      else
        [nil, nil]
      end
  %>
  <% if description_source %>
    <div class="bundle__description" data-source="<%= description_source %>">
      <%== description_content %>
    </div>
  <% end %>

  <%== page.content %>

  <%# Books in this bundle. `publications:` is an array of slugs (the
      canonical shape). Some publisher payloads carry richer entries
      (with embedded title + cover_url) so we honour any inline data
      that's been preserved. Cards use the shared `_publication_card`
      partial so visual treatment matches the publications-index. %>
  <%
    source_pubs = Array(fm['publications'])
    pubs_cfg = site.collection_config('publications')
    pubs_prefix = pubs_cfg['slug'].to_s.empty? ?
      pubs_cfg['permalink'].to_s.sub(':slug/', '').sub(':slug', '') :
      "/#{pubs_cfg['slug']}/"
    pubs_prefix = '/publications/' if pubs_prefix.empty?
  %>
  <% if source_pubs.any? %>
    <section class="bundle__contents">
      <h2 class="bundle__contents-heading">What's included</h2>
      <ul class="publications-index">
        <% source_pubs.each_with_index do |entry, idx| %>
          <%
            entry    = { 'slug' => entry } if entry.is_a?(String)
            slug     = entry['slug']
            card_pub = publication_card_data(slug)
            # Inline entries (some publisher payloads carry these)
            # may include their own title / cover_url. Honour those
            # over the looked-up publication's fields if both exist.
            card_pub[:title] = entry['title']     if entry['title']
            card_pub[:cover] = entry['cover_url'] if entry['cover_url']
          %>
          <%== render 'partials/publication_card',
                     pub: card_pub,
                     idx: idx,
                     pubs_prefix: pubs_prefix,
                     heading_level: 3 %>
        <% end %>
      </ul>
    </section>
  <% end %>
</article>
