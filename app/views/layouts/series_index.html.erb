---
layout: application
---
<!--
  Unified series taxonomy page — handles series for any collection.
  Auto-generated by the engine for each (collection, series-name)
  pair when an item carries `series:` in its frontmatter.

  URLs are per-collection so naming collisions don't matter:
    /posts/series/<slug>/        → posts with `series: "<name>"`
    /photos/series/<slug>/       → photos with `series: "<name>"`
    /publications/series/<slug>/ → publications with `series: "<name>"`
                                    (+ Folio publications whose series
                                    field matches)
    /workshops/series/<slug>/    → workshops with `series: "<name>"`

  Items are sorted by `series_position` (integer) ascending, then by
  date descending as a tiebreaker. Items without a position sort to
  the end of the list — useful when only some entries in a series
  carry an explicit ordinal.

  Each collection renders with its own card style:
    - posts        → `_post_list` partial
    - photos       → inline gallery tiles (same shape as gallery_index)
    - publications → `_publication_card` partial (Folio + manual)
    - workshops    → inline workshop summary cards
-->
<%
  series_config = site.taxonomy_config(page.taxonomy)
  coll          = series_config['collection']

  # Position-then-date sort. nil positions go last; positive ints
  # land in ascending order; ties resolved by date (newest first).
  items = page.posts.sort_by do |item|
    pos = item.frontmatter['series_position']
    [pos.nil? ? Float::INFINITY : pos.to_i,
     -(item.respond_to?(:date) && item.date ? item.date.to_i : 0)]
  end

  # Publication-series: merge Folio publications whose `series` field
  # matches this term. Folio entries aren't Page instances; we render
  # them via the same `_publication_card` partial as manual entries
  # by normalising both shapes to a card-data hash up front.
  folio_pub_extras = []
  if coll == 'publications'
    manual_slugs = items.map { |it| it.respond_to?(:slug) ? it.slug : nil }.compact.to_set
    (site.data['folio_publications'] || {}).each do |slug, pub|
      next if manual_slugs.include?(slug)
      next unless pub['series'].to_s == page.term.to_s
      folio_pub_extras << pub.merge('_slug' => slug, '_position' => pub.dig('in_series', 'position'))
    end
  end

  total = items.size + folio_pub_extras.size

  # Item label for the lede — singular collection name, pluralised
  # for the count.
  label = case coll
          when 'posts'        then 'post'
          when 'photos'       then 'photo'
          when 'publications' then 'publication'
          when 'workshops'    then 'workshop'
          else                     'item'
          end
%>
<article>
  <header>
    <h1><%= page.term %></h1>
    <p class="lede"><%= pluralize(total, label) %></p>
  </header>

  <% if coll == 'posts' %>
    <%== render 'partials/post_list', posts: items %>

  <% elsif coll == 'photos' %>
    <%
      photos_cfg     = (site.collection_config('photos')['index'] || {})
      show_location  = photos_cfg.fetch('show_location', true)
      show_date      = photos_cfg.fetch('show_date',     true)
      show_camera    = photos_cfg.fetch('show_camera',   false)
      show_caption   = photos_cfg.fetch('show_caption',  false)
      cols           = photos_cfg['cols'].to_i
      cols           = nil unless [2, 3, 4].include?(cols)
    %>
    <ul class="gallery-index<%= " gallery-index--cols-#{cols}" if cols %>">
      <% items.each_with_index do |photo, idx| %>
        <% tint = "gallery-index__cover--tint-#{(idx % 4) + 1}" %>
        <% position = photo.frontmatter['series_position'] %>
        <li>
          <a href="<%= sanitized_url(photo.url) %>">
            <div class="gallery-index__cover <%= tint %>">
              <% if photo.frontmatter['image'] %>
                <img src="<%= sanitized_url(bundle_asset_url_for(photo, photo.frontmatter['image'])) %>"
                     alt="<%= photo.frontmatter['caption'] || photo.title %>"
                     width="1200" height="1200"
                     loading="lazy"
                     decoding="async">
              <% end %>
            </div>
            <span class="gallery-index__title">
              <% if position %><span class="series-position">#<%= position %></span> <% end %><%= photo.title %>
            </span>
            <% if show_location && (photo.frontmatter['city'] || photo.frontmatter['country']) %>
              <span class="gallery-index__location">
                <%= [photo.frontmatter['city'], photo.frontmatter['country']].compact.join(', ') %>
              </span>
            <% end %>
            <% if show_date && photo.date %>
              <span class="gallery-index__date">
                <time datetime="<%= photo.date.iso8601 %>"><%= local_time(photo.date) %></time>
              </span>
            <% end %>
            <% if show_camera && photo.frontmatter['camera'] %>
              <span class="gallery-index__camera"><%= photo.frontmatter['camera'] %></span>
            <% end %>
            <% if show_caption && photo.frontmatter['caption'] %>
              <span class="gallery-index__caption"><%= truncate(photo.frontmatter['caption'], length: photos_cfg.fetch('caption_truncate', 100)) %></span>
            <% end %>
          </a>
        </li>
      <% end %>
    </ul>

  <% elsif coll == 'publications' %>
    <%
      pub_cfg    = site.collection_config('publications')
      index_cfg  = pub_cfg['index'] || {}
      truncate_at      = index_cfg.fetch('description_truncate', 200)
      show_description = index_cfg.fetch('show_description', true)
      show_price       = index_cfg.fetch('show_price',       true)
      show_isbn        = index_cfg.fetch('show_isbn',        false)
      show_pages       = index_cfg.fetch('show_pages',       false)
      show_published   = index_cfg.fetch('show_published',   false)
      pubs_prefix      = pub_cfg['slug'].to_s.empty? ?
        pub_cfg['permalink'].to_s.sub(':slug/', '').sub(':slug', '') :
        "/#{pub_cfg['slug']}/"
      pubs_prefix = '/publications/' if pubs_prefix.empty?

      # Merge manual + Folio. publication_card_data fills in fields
      # for manual entries; the Folio-only extras are built inline so
      # we can still slot in `:position` from `in_series.position`.
      merged = items.map do |item|
        publication_card_data(item.respond_to?(:slug) ? item.slug : nil)
          .merge(position: item.frontmatter['series_position'])
      end
      merged += folio_pub_extras.map do |pub|
        slug = pub['_slug']
        publication_card_data(slug).merge(position: pub['_position'])
      end
      merged.sort_by! { |it| [it[:position].nil? ? Float::INFINITY : it[:position].to_i, it[:title].to_s] }
    %>
    <ul class="publications-index">
      <% merged.each_with_index do |pub, idx| %>
        <%== render 'partials/publication_card',
                   pub: pub,
                   idx: idx,
                   pubs_prefix: pubs_prefix,
                   heading_level: 2,
                   show_description: show_description,
                   show_price: show_price,
                   show_isbn: show_isbn,
                   show_pages: show_pages,
                   show_published: show_published,
                   truncate_at: truncate_at %>
      <% end %>
    </ul>

  <% elsif coll == 'workshops' %>
    <ul class="workshops-series">
      <% items.each do |w| %>
        <% fm = w.frontmatter %>
        <% position = fm['series_position'] %>
        <li class="workshops-series__item">
          <a href="<%= sanitized_url(w.url) %>">
            <h3 class="workshops-series__title">
              <% if position %><span class="series-position">#<%= position %></span> <% end %><%= w.title %>
            </h3>
            <% if (df = fm['date_from']) %>
              <p class="workshops-series__meta">
                <time datetime="<%= to_time(df).iso8601 %>"><%= local_time(df) %></time>
                <% if fm['location'] %> &middot; <%= fm['location'] %><% end %>
                <% if fm['format'] %> &middot; <%= fm['format'] %><% end %>
              </p>
            <% end %>
            <% if (desc = fm['description'].to_s) && !desc.empty? %>
              <p class="workshops-series__description"><%= truncate(desc, length: 160) %></p>
            <% end %>
          </a>
        </li>
      <% end %>
    </ul>

  <% else %>
    <%# Unknown collection (e.g. a user-defined collection with a
        series taxonomy pointed at it). Fall back to a plain list. %>
    <ul>
      <% items.each do |item| %>
        <li><a href="<%= sanitized_url(item.url) %>"><%= item.title %></a></li>
      <% end %>
    </ul>
  <% end %>
</article>
