# frozen_string_literal: true

source 'https://rubygems.org'

# Abqari is the static site generator. The engine ships content
# pipelines, layouts, helpers, themes, and the build orchestrator.
# Switch this line to a `tag:` once you're pinning to a versioned
# release. The gem's own runtime deps (commonmarker, rouge, webrick,
# base64) come in transitively via abqari.gemspec.
<%= gemfile_line %>

group :development do
  gem 'listen', '~> 3.8'    # FS events for the dev-server watcher (optional)
end
