# frozen_string_literal: true

source 'https://rubygems.org'

# Abqari is the static site generator. The engine ships content
# pipelines, layouts, helpers, themes, and the build orchestrator.
# Its runtime deps (commonmarker, erubi, rouge, ruby-vips, webrick,
# and friends) come in transitively via abqari.gemspec. To track a
# fork or a local checkout instead of the released gem, swap this
# line for a `git:` or `path:` source.
<%= gemfile_line %>

group :development do
  gem 'listen', '~> 3.8'    # FS events for the dev-server watcher (optional)
end
