#!/usr/bin/env ruby
# frozen_string_literal: true

# Self-host fonts declared in config/site.yml. Downloads woff2 files from
# Google Fonts and writes a fonts.css with rewritten URLs into vendor/fonts/.
# Run once after adding/changing the `fonts:` block. Build copies the result
# into _site/assets/fonts/.

ENV['ABQARI_SITE_ROOT'] ||= File.expand_path('..', __dir__)
# Resolve the bundle from this site, not from cwd — `bundler/setup`
# finds its Gemfile relative to the current directory, so running this
# from elsewhere would load an unrelated bundle (or none) and fail.
ENV['BUNDLE_GEMFILE']   ||= File.expand_path('../Gemfile', __dir__)

require 'bundler/setup'
require 'abqari'

Abqari.run_cli do
  Abqari::FontPipeline.new(Abqari::Site.new).fetch
end
