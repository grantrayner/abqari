#!/usr/bin/env ruby
# frozen_string_literal: true

# Build the site. Flags:
#   --verbose / -v   — set ABQARI_LOG=debug for extra build-time output
#                      (incremental decisions, parallel slice info,
#                      cache hits, etc.).
#   --quiet   / -q   — set ABQARI_LOG=warn to suppress info-level lines.

require 'optparse'

options = {}
OptionParser.new do |opts|
  opts.banner = 'Usage: bin/build [--verbose|--quiet]'
  opts.on('-v', '--verbose', 'Verbose build output (ABQARI_LOG=debug)') { options[:log] = 'debug' }
  opts.on('-q', '--quiet',   'Suppress info-level output (ABQARI_LOG=warn)') { options[:log] = 'warn' }
end.parse!(ARGV)

ENV['ABQARI_LOG']         = options[:log] if options[:log]
ENV['ABQARI_ENV']       ||= 'production'
ENV['ABQARI_SITE_ROOT'] ||= File.expand_path('..', __dir__)
# Resolve the bundle from this site, not from cwd — `bundler/setup`
# finds its Gemfile relative to the current directory, so running this
# from elsewhere would load an unrelated bundle (or none) and fail.
ENV['BUNDLE_GEMFILE']   ||= File.expand_path('../Gemfile', __dir__)

require 'bundler/setup'
require 'abqari'

Abqari.run_cli do
  Abqari::Site.new.build
end
