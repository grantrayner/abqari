_site/
_import_report.md
# Ignore the webmention/POSSE caches but KEEP the `sent.yml` dedup logs
# committed — they're what stops a fresh CI checkout from re-posting
# every recent entry on each deploy.
vendor/webmentions/*
!vendor/webmentions/sent.yml
vendor/syndication/*
!vendor/syndication/sent.yml
.bundle/
vendor/bundle/
vendor/folio/
*.log
.DS_Store

# Generated reports — regenerated by `bin/audit` and `COVERAGE=1 bin/test`.
# Anchored with a leading slash so the patterns only match the top-level
# report directories — without the slash, `audit/` would also exclude
# the engine's source tree at `lib/abqari/audit/`.
/audit/
/coverage/

# AI tools
.claude/
# Built gem artifacts — regenerated by 'gem build abqari.gemspec'
*.gem
